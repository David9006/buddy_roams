+/*---------------------------------------------------------------------------------------------
+ *  Copyright (c) Microsoft Corporation. All rights reserved.
+ *  Licensed under the MIT License. See License.txt in the project root for license information.
+ *--------------------------------------------------------------------------------------------*/
+
+import type * as vscode from 'vscode';
+import { createDecorator } from '../../../platform/instantiation/common/instantiation.js';
+import { MainContext, MainThreadEditorOverlayShape } from './extHost.protocol.js';
+import { IExtHostRpcService } from './extHostRpcService.js';
+
+export interface IExtHostEditorOverlay extends ExtHostEditorOverlay { }
+
+export class ExtHostEditorOverlay {
+
+	declare _serviceBrand: undefined;
+
+	private static _idPool = 0;
+
+	private readonly _proxy: MainThreadEditorOverlayShape;
+
+	constructor(
+		@IExtHostRpcService extHostRpc: IExtHostRpcService,
+	) {
+		this._proxy = extHostRpc.getProxy(MainContext.MainThreadEditorOverlay);
+	}
+
+	createEditorOverlay(options: vscode.EditorOverlayOptions = {}): vscode.EditorOverlay {
+		const id = `editor-overlay:${++ExtHostEditorOverlay._idPool}`;
+		const proxy = this._proxy;
+		const suppressEvents = options.suppressEvents !== false;
+
+		void proxy.$create(id, suppressEvents);
+
+		return {
+			id,
+			setHtml: (html: string) => proxy.$setHtml(id, html),
+			show: () => proxy.$show(id),
+			hide: () => proxy.$hide(id),
+			dispose: () => proxy.$dispose(id),
+		};
+	}
+}
+
+export const IExtHostEditorOverlay = createDecorator<IExtHostEditorOverlay>('IExtHostEditorOverlay');
