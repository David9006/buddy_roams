+import { getActiveWindow } from '../../../base/browser/dom.js';
+import { Disposable, DisposableMap, IDisposable } from '../../../base/common/lifecycle.js';
+import { IOverlayWebview, IWebviewService } from '../../contrib/webview/browser/webview.js';
+import { extHostNamedCustomer, IExtHostContext } from '../../services/extensions/common/extHostCustomers.js';
+import { IWorkbenchLayoutService, Parts } from '../../services/layout/browser/layoutService.js';
+import { MainContext, MainThreadEditorOverlayShape } from '../common/extHost.protocol.js';
+
+interface IOverlayEntry extends IDisposable {
+	readonly webview: IOverlayWebview;
+}
+
+@extHostNamedCustomer(MainContext.MainThreadEditorOverlay)
+export class MainThreadEditorOverlay extends Disposable implements MainThreadEditorOverlayShape {
+
+	private readonly _overlays = this._register(new DisposableMap<string, IOverlayEntry>());
+	private _anchorElement: HTMLElement | undefined;
+
+	constructor(
+		extHostContext: IExtHostContext,
+		@IWebviewService private readonly _webviewService: IWebviewService,
+		@IWorkbenchLayoutService private readonly _layoutService: IWorkbenchLayoutService,
+	) {
+		super();
+
+		this._register(this._layoutService.onDidLayoutContainer(() => this.updateAnchor()));
+		this._register(this._layoutService.onDidChangeActiveContainer(() => this.updateAnchor()));
+	}
+
+	$create(id: string, suppressEvents: boolean): Promise<void> {
+		if (this._overlays.has(id)) {
+			throw new Error(`Editor overlay '${id}' already exists`);
+		}
+
+		const webview = this._webviewService.createWebviewOverlay({
+			providedViewType: 'editor-overlay',
+			title: 'Editor Overlay',
+			options: {},
+			contentOptions: {
+				allowScripts: true,
+				allowForms: false,
+			},
+			extension: undefined,
+		});
+
+		webview.claim(this, getActiveWindow(), undefined);
+		webview.setAnchorElement(this.getOrCreateAnchorElement());
+
+		if (suppressEvents) {
+			webview.container.style.pointerEvents = 'none';
+		}
+
+		const entry: IOverlayEntry = {
+			webview,
+			dispose: () => {
+				try {
+					webview.release(this);
+				} finally {
+					webview.dispose();
+				}
+			},
+		};
+
+		this._overlays.set(id, entry);
+		return Promise.resolve();
+	}
+
+	$setHtml(id: string, html: string): Promise<void> {
+		this.tryGetWebview(id)?.setHtml(html);
+		return Promise.resolve();
+	}
+
+	$show(id: string): Promise<void> {
+		const webview = this.tryGetWebview(id);
+		if (webview) {
+			webview.claim(this, getActiveWindow(), undefined);
+			webview.container.style.display = '';
+		}
+		return Promise.resolve();
+	}
+
+	$hide(id: string): Promise<void> {
+		const webview = this.tryGetWebview(id);
+		if (webview) {
+			webview.container.style.display = 'none';
+		}
+		return Promise.resolve();
+	}
+
+	$dispose(id: string): Promise<void> {
+		this._overlays.deleteAndDispose(id);
+		return Promise.resolve();
+	}
+
+	private tryGetWebview(id: string): IOverlayWebview | undefined {
+		return this._overlays.get(id)?.webview;
+	}
+
+	private getOrCreateAnchorElement(): HTMLElement {
+		if (!this._anchorElement) {
+			const anchor = document.createElement('div');
+			anchor.className = 'monaco-editor-overlay-anchor';
+			anchor.style.position = 'fixed';
+			anchor.style.pointerEvents = 'none';
+			document.body.appendChild(anchor);
+			this._anchorElement = anchor;
+
+			this.updateAnchor();
+		}
+		return this._anchorElement;
+	}
+
+	private updateAnchor(): void {
+		const container = this._layoutService.getContainer(getActiveWindow(), Parts.EDITOR_PART);
+		if (!container || !this._anchorElement) {
+			return;
+		}
+
+		const rect = container.getBoundingClientRect();
+		this._anchorElement.style.left = `${rect.left}px`;
+		this._anchorElement.style.top = `${rect.top}px`;
+		this._anchorElement.style.width = `${rect.width}px`;
+		this._anchorElement.style.height = `${rect.height}px`;
+	}
+}
