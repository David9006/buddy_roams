{
  "name": "buddy-roams",
  "displayName": "Buddy Roams",
  "description": "Brings a roaming pet into the editor area using the patched `window.createEditorOverlay` API.",
  "icon": "icon.png",
  "extensionKind": [
    "ui"
  ],
  "keywords": [
    "pet",
    "buddy",
    "chat"
  ],
  "version": "1.0.0",
  "publisher": "Gapple",
  "license": "SEE LICENSE IN LICENSE",
  "engines": {
    "vscode": "^1.141.0"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/David9006/buddy_unleashed.git"
  },
  "homepage": "https://github.com/David9006/buddy_unleashed/blob/main/README.md",
  "categories": [
    "Other"
  ],
  "activationEvents": [
    "onStartupFinished"
  ],
  "main": "./dist/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "buddy-roams.toggle",
        "title": "Toggle",
        "category": "Buddy Roams"
      },
      {
        "command": "buddy-roams.install",
        "title": "Install",
        "category": "Buddy Roams"
      },
      {
        "command": "buddy-roams.uninstall",
        "title": "Uninstall",
        "category": "Buddy Roams"
      },
      {
        "command": "buddy-roams.diagnose",
        "title": "Diagnose",
        "category": "Buddy Roams"
      }
    ],
    "keybindings": [
      {
        "command": "buddy-roams.toggle",
        "key": "alt+cmd+p",
        "mac": "alt+cmd+p",
        "when": "editorTextFocus"
      }
    ],
    "configuration": {
      "title": "Buddy Roams",
      "properties": {
        "betterPet.appRoot": {
          "type": "string",
          "default": "",
          "description": "Absolute path to the VS Code 'Resources/app' directory to patch. Leave empty to auto-detect the running editor (vscode.env.appRoot). Example (macOS): /Applications/Visual Studio Code.app/Contents/Resources/app"
        }
      }
    }
  },
  "scripts": {
    "compile": "tsc -p ./ && node -e \"var fs=require('fs');fs.copyFileSync('src/engine.js','dist/engine.js');fs.copyFileSync('src/chatPet.css','dist/chatPet.css');\"",
    "watch": "tsc -watch -p ./",
    "vscode:prepublish": "npm run compile"
  },
  "devDependencies": {
    "@types/node": "^20.14.0",
    "@types/vscode": "^1.100.0",
    "typescript": "^5.5.0"
  }
}
